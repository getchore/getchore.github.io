# The chore website. Served at the root of getchore.github.io.
#
# The language reference on this site is generated from `chore spec`, so the
# build wants a chore on PATH. Without one it falls back to the committed
# src/spec.json and says so.

# Install the pinned dependencies.
task deps {
    pnpm install --frozen-lockfile
}

# Build the site the way Pages serves it.
task build {
    deps
    pnpm build
}

# Serve the site locally with hot reload.
task dev {
    deps
    pnpm dev
}

# Remove the build output.
task clean {
    remove dist
}
